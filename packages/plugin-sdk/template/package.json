{
  "name": "my-modforge-plugin",
  "version": "0.1.0",
  "description": "A ModForge Studio compat plugin with a custom code-package page.",
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --format=esm --external:react --external:react-dom --external:@modforge/plugin-sdk --outfile=dist/index.js",
    "dev": "esbuild src/index.ts --bundle --format=esm --external:react --external:react-dom --external:@modforge/plugin-sdk --outfile=dist/index.js --watch"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "@modforge/plugin-sdk": "^1.0.0"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  }
}
