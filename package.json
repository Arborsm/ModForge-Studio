{
  "name": "modforge-studio",
  "private": true,
  "version": "0.1.0",
  "license": "GPL-3.0-or-later",
  "packageManager": "pnpm@11.5.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --filter @modforge/desktop dev",
    "desktop:dev": "node ./scripts/desktop-host-dispatch.cjs dev",
    "build": "pnpm --filter @modforge/desktop build",
    "lint": "pnpm --filter @modforge/desktop lint",
    "desktop:build": "node ./scripts/desktop-host-dispatch.cjs build",
    "release:linux": "pnpm --filter @modforge/desktop release:linux",
    "release:linux:deb": "pnpm --filter @modforge/desktop release:linux:deb",
    "release:linux:rpm": "pnpm --filter @modforge/desktop release:linux:rpm",
    "release:macos": "pnpm --filter @modforge/desktop release:macos",
    "release:windows": "pnpm --filter @modforge/desktop release:windows",
    "release:all": "pnpm --filter @modforge/desktop release:all",
    "release:collect": "pnpm --filter @modforge/desktop release:collect",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "prepare": "husky"
  },
  "lint-staged": {
    "*": "prettier --ignore-unknown --write"
  },
  "devDependencies": {
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "lint-staged": "17.0.7",
    "prettier": "3.8.3",
    "prettier-plugin-tailwindcss": "0.8.0"
  }
}
