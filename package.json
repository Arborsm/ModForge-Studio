{
  "name": "modforge-studio",
  "private": true,
  "version": "0.1.0",
  "license": "GPL-3.0-or-later",
  "packageManager": "pnpm@11.5.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "web:dev": "vp run --filter @modforge/desktop dev",
    "cleanup:shmem": "vp run --filter @modforge/desktop cleanup:shmem",
    "react:devtools": "vp run --filter @modforge/desktop react:devtools",
    "build": "vp run --filter @modforge/desktop build",
    "lint": "vp run --filter @modforge/desktop lint",
    "benchmark:localization-search": "vp run --filter @modforge/desktop benchmark:localization-search",
    "benchmark:localization-lexical": "vp run --filter @modforge/desktop benchmark:localization-lexical",
    "desktop:build": "node ./scripts/desktop-host-dispatch.cjs build",
    "installer:build": "node apps/installer/scripts/build-installer.cjs",
    "release:linux": "vp run --filter @modforge/desktop release:linux",
    "release:linux:deb": "vp run --filter @modforge/desktop release:linux:deb",
    "release:linux:rpm": "vp run --filter @modforge/desktop release:linux:rpm",
    "release:macos": "vp run --filter @modforge/desktop release:macos",
    "release:windows": "vp run --filter @modforge/desktop release:windows",
    "release:all": "vp run --filter @modforge/desktop release:all",
    "release:collect": "vp run --filter @modforge/desktop release:collect",
    "format": "vp fmt .",
    "format:check": "vp fmt . --check",
    "design:lint": "npx -p @google/design.md designmd lint DESIGN.md",
    "design:export": "npx -p @google/design.md designmd export --format json-tailwind DESIGN.md > design-tokens.json",
    "design:export:css": "npx -p @google/design.md designmd export --format css-tailwind DESIGN.md > design-tokens.css",
    "design:export:dtcg": "npx -p @google/design.md designmd export --format dtcg DESIGN.md > design-tokens.dtcg.json",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{css,html,js,json,jsonc,jsx,md,mdx,ts,tsx,yaml,yml}": "vp fmt .",
    "*.rs": "node apps/desktop/scripts/fmt-rust-staged.cjs"
  },
  "devDependencies": {
    "husky": "9.1.7",
    "lint-staged": "17.0.8",
    "vite-plus": "catalog:"
  }
}
