{
  "name": "modforge-studio",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.30.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "pnpm": {
    "supportedArchitectures": {
      "os": [
        "linux",
        "win32"
      ],
      "cpu": [
        "x64"
      ],
      "libc": [
        "glibc"
      ]
    }
  },
  "scripts": {
    "dev": "pnpm --filter @modforge/desktop dev",
    "desktop:dev": "pnpm --filter @modforge/desktop tauri dev",
    "build": "pnpm --filter @modforge/desktop build",
    "lint": "pnpm --filter @modforge/desktop lint",
    "desktop:build": "pnpm --filter @modforge/desktop tauri build",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "prepare": "husky"
  },
  "lint-staged": {
    "*": "prettier --ignore-unknown --write"
  },
  "devDependencies": {
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "lint-staged": "17.0.4",
    "prettier": "3.8.3",
    "prettier-plugin-tailwindcss": "0.8.0"
  }
}
