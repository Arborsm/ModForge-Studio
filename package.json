{
  "name": "modforge-studio",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.30.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --filter @modforge/desktop dev",
    "desktop:dev": "pnpm --filter @modforge/desktop tauri dev",
    "build": "pnpm --filter @modforge/desktop build",
    "lint": "pnpm --filter @modforge/desktop lint",
    "desktop:build": "pnpm --filter @modforge/desktop tauri build"
  }
}
