{
  "version": 1,
  "include": [
    "apps/desktop/**/*.ts",
    "apps/desktop/**/*.tsx",
    "apps/desktop/**/*.js",
    "apps/desktop/**/*.jsx",
    "apps/desktop/src-tauri/**/*.rs"
  ],
  "exclude": [
    "**/.git/**",
    "**/.cargo/**",
    "**/.codex/**",
    "**/.codex-tmp/**",
    "**/.devDocs/**",
    "**/.husky/**",
    "**/.idea/**",
    "**/.planning/**",
    "**/.superpowers/**",
    "**/.tmp/**",
    "**/.tmp-*/**",
    "**/.vscode/**",
    "**/.zed/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/out/**",
    "**/coverage/**",
    "**/target/**",
    "**/.next/**",
    "**/.nuxt/**",
    "**/.svelte-kit/**",
    "**/.output/**",
    "**/.turbo/**",
    "**/.cache/**",
    "**/.vite/**",
    "**/test-results/**",
    "**/*.d.ts",
    "**/*.min.js",
    "**/*.bundle.js",
    "**/*.lock",
    "**/package-lock.json",
    "**/pnpm-lock.yaml"
  ],
  "languages": ["typescript", "javascript", "rust"],
  "frameworks": [],
  "maxFileSize": 1048576,
  "extractDocstrings": true,
  "trackCallSites": true
}
