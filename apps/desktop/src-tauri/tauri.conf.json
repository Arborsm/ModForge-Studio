{
  "$schema": "../../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ModForge Studio",
  "version": "0.1.0",
  "identifier": "studio.modforge.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "vp run --filter @modforge/desktop dev",
    "beforeBuildCommand": "vp run --filter @modforge/desktop build"
  },
  "app": {
    "windows": [
      {
        "title": "ModForge Studio",
        "width": 1600,
        "height": 1000,
        "minWidth": 1280,
        "minHeight": 800,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["$DATA/ModForge Studio/**"],
          "requireLiteralLeadingDot": false
        }
      },
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
