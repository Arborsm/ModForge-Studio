{
  "format": 1,
  "id": "peacefulend.alternative-textures",
  "name": "Alternative Textures 兼容",
  "targets": ["PeacefulAlternativeTextures.AlternativeTextures"],
  "contributions": {
    "pages": [
      {
        "id": "at-texture-editor",
        "navigation": { "section": "tools", "order": 900, "icon": "images" },
        "titleKey": "at.page.title",
        "presentation": "standalone",
        "projectAccess": "none",
        "source": {
          "kind": "directory-pack",
          "params": {
            "entryFile": "texture.json",
            "entryImage": "texture.png",
            "rootSubdir": "Textures"
          }
        },
        "layout": "two-column",
        "validations": [
          {
            "kind": "require-one-of",
            "paths": ["ItemName", "ItemId", "CollectiveNames", "CollectiveIds"],
            "messageKey": "at.validation.requireOneIdentifier"
          }
        ],
        "sections": [
          {
            "titleKey": "at.section.identity",
            "fields": [
              {
                "id": "itemName",
                "path": "ItemName",
                "type": "text",
                "labelKey": "at.field.itemName"
              },
              {
                "id": "itemId",
                "path": "ItemId",
                "type": "text",
                "labelKey": "at.field.itemId"
              },
              {
                "id": "collectiveNames",
                "path": "CollectiveNames",
                "type": "string-list",
                "labelKey": "at.field.collectiveNames"
              },
              {
                "id": "collectiveIds",
                "path": "CollectiveIds",
                "type": "string-list",
                "labelKey": "at.field.collectiveIds"
              },
              {
                "id": "type",
                "path": "Type",
                "type": "choice",
                "allowValues": ["Crop", "Craftable", "Building", "FruitTree", "Grass"],
                "labelKey": "at.field.type",
                "required": true
              },
              {
                "id": "variations",
                "path": "Variations",
                "type": "number",
                "min": 1,
                "max": 64,
                "interval": 1,
                "labelKey": "at.field.variations"
              },
              {
                "id": "textureWidth",
                "path": "TextureWidth",
                "type": "number",
                "min": 16,
                "max": 2048,
                "interval": 1,
                "labelKey": "at.field.textureWidth"
              },
              {
                "id": "textureHeight",
                "path": "TextureHeight",
                "type": "number",
                "min": 16,
                "max": 2048,
                "interval": 1,
                "labelKey": "at.field.textureHeight"
              }
            ]
          },
          {
            "titleKey": "at.section.appearance",
            "fields": [
              {
                "id": "seasons",
                "path": "Seasons",
                "type": "string-list",
                "labelKey": "at.field.seasons"
              },
              {
                "id": "chanceWeight",
                "path": "ChanceWeight",
                "type": "number",
                "min": 0,
                "max": 1,
                "interval": 0.01,
                "labelKey": "at.field.chanceWeight"
              },
              {
                "id": "manualVariations",
                "path": "ManualVariations",
                "type": "record-list",
                "labelKey": "at.field.manualVariations",
                "fields": [
                  {
                    "id": "keywords",
                    "path": "Keywords",
                    "type": "string-list",
                    "labelKey": "at.field.manualVariationKeywords"
                  },
                  {
                    "id": "chanceWeight",
                    "path": "ChanceWeight",
                    "type": "number",
                    "min": 0,
                    "max": 1,
                    "interval": 0.01,
                    "labelKey": "at.field.manualVariationChanceWeight"
                  }
                ]
              }
            ]
          },
          {
            "titleKey": "at.section.advanced",
            "fields": [
              {
                "id": "enableAnimation",
                "path": "EnableAnimation",
                "type": "bool",
                "labelKey": "at.field.enableAnimation"
              },
              {
                "id": "animation",
                "path": "Animation",
                "type": "object",
                "labelKey": "at.field.animation",
                "visibleWhen": { "kind": "field-eq", "field": "EnableAnimation", "value": true },
                "subFields": [
                  {
                    "id": "frameDuration",
                    "path": "FrameDuration",
                    "type": "number",
                    "min": 1,
                    "max": 10000,
                    "interval": 1,
                    "labelKey": "at.field.animationFrameDuration"
                  },
                  {
                    "id": "frameCount",
                    "path": "FrameCount",
                    "type": "number",
                    "min": 1,
                    "max": 256,
                    "interval": 1,
                    "labelKey": "at.field.animationFrameCount"
                  }
                ]
              },
              {
                "id": "enableTints",
                "path": "EnableTints",
                "type": "bool",
                "labelKey": "at.field.enableTints"
              },
              {
                "id": "tints",
                "path": "Tints",
                "type": "object",
                "labelKey": "at.field.tints",
                "visibleWhen": { "kind": "field-eq", "field": "EnableTints", "value": true },
                "subFields": [
                  {
                    "id": "redTint",
                    "path": "RedTint",
                    "type": "number",
                    "min": 0,
                    "max": 255,
                    "interval": 1,
                    "labelKey": "at.field.tintRed"
                  },
                  {
                    "id": "greenTint",
                    "path": "GreenTint",
                    "type": "number",
                    "min": 0,
                    "max": 255,
                    "interval": 1,
                    "labelKey": "at.field.tintGreen"
                  },
                  {
                    "id": "blueTint",
                    "path": "BlueTint",
                    "type": "number",
                    "min": 0,
                    "max": 255,
                    "interval": 1,
                    "labelKey": "at.field.tintBlue"
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
