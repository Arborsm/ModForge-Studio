{
  "name": "@modforge/desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node ./scripts/run-vite-dev.mjs",
    "dev:event-assets": "cargo run --manifest-path src-tauri/Cargo.toml --features dev-asset-bridge --bin event-asset-bridge",
    "dev:force": "vite --configLoader runner --force",
    "build": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && vite build --configLoader runner",
    "lint": "eslint .",
    "test": "node ./scripts/cleanup-vitest-processes.cjs && vitest run --configLoader runner --pool=threads --maxWorkers=3",
    "test:cleanup": "node ./scripts/cleanup-vitest-processes.cjs",
    "test:launcher-drag": "node ./scripts/verify-launcher-drag.mjs",
    "test:launcher-fast-scroll": "node ./scripts/verify-launcher-fast-scroll.mjs",
    "test:launcher-performance": "node ./scripts/verify-launcher-performance.mjs",
    "preview": "vite preview --configLoader runner",
    "tauri": "node ./scripts/run-tauri-cli.cjs"
  },
  "dependencies": {
    "@air/react-drag-to-select": "^5.0.11",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@floating-ui/react": "^0.27.19",
    "@nexusmods/nexus-api": "1.1.5",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@tailwindcss/postcss": "^4.3.0",
    "@tanstack/react-virtual": "^3.13.24",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@xyflow/react": "^12.10.2",
    "autoprefixer": "^10.5.0",
    "lucide-react": "^1.16.0",
    "postcss": "^8.5.14",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-resizable-panels": "^4.11.1",
    "tailwindcss": "^4.3.0",
    "zustand": "^5.0.13"
  },
  "optionalDependencies": {
    "@rolldown/binding-linux-x64-gnu": "1.0.1",
    "@rolldown/binding-win32-x64-msvc": "1.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.11.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.8.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.60.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.59.3",
    "vite": "^8.0.12",
    "vitest": "^4.1.6"
  }
}
