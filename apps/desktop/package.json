{
  "name": "@modforge/desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Desktop workbench for Stardew Valley mod creation and management.",
  "author": "ModForge Studio <dev@modforge.studio>",
  "homepage": "https://modforge.studio",
  "license": "GPL-3.0-or-later",
  "desktopName": "io.github.Arborsm.ModForgeStudio.desktop",
  "type": "module",
  "scripts": {
    "dev": "node ./scripts/run-vite-dev.mjs",
    "dev:event-assets": "cargo run --manifest-path src-tauri/Cargo.toml --features dev-asset-bridge --example event_asset_bridge",
    "dev:force": "vp dev --configLoader runner --force",
    "react:devtools": "react-devtools",
    "gen:host-commands": "node ./scripts/generate-host-commands.mjs",
    "gen:app-icons": "node ./scripts/generate-app-icons.mjs",
    "electron:dev": "node ./scripts/run-electron-dev.mjs",
    "build:gmcm-probe": "node ./scripts/build-gmcm-probe.mjs",
    "electron:build": "node ./scripts/build-electron-release.cjs",
    "electron:build:deb": "node ./scripts/build-electron-release.cjs deb",
    "electron:build:rpm": "node ./scripts/build-electron-release.cjs rpm",
    "cleanup:shmem": "node ./scripts/cleanup-shared-memory.mjs",
    "build": "vp run build:web",
    "build:web": "node ./scripts/build-web.cjs",
    "release:linux": "node ./scripts/build-electron-release.cjs",
    "release:linux:deb": "node ./scripts/build-electron-release.cjs deb",
    "release:linux:rpm": "node ./scripts/build-electron-release.cjs rpm",
    "release:macos": "node ./scripts/release-macos.cjs",
    "release:windows": "node ./scripts/run-tauri-cli.cjs build --verbose --bundles nsis",
    "release:all": "node ./scripts/release-current-platform.cjs",
    "release:collect": "node ./scripts/collect-release-artifacts.cjs",
    "lint": "vp lint .",
    "lint:tailwind": "tailwind-lint --config src/styles/index.css \"src/**/*.{ts,tsx}\"",
    "lint:tailwind:fix": "tailwind-lint --config src/styles/index.css \"src/**/*.{ts,tsx}\" --fix",
    "test": "vp run test:frontend && vp run test:node",
    "test:frontend": "node ./scripts/cleanup-vitest-processes.cjs && node ./scripts/run-frontend-tests.mjs",
    "test:node": "node --test ./scripts/frontend-test-warning-gate.test.mjs ./scripts/scan-gmcm-probe.test.mjs ../../docs/nexusmods-graphql/convert-to-markdown.test.mjs",
    "test:cleanup": "node ./scripts/cleanup-vitest-processes.cjs",
    "test:launcher-custom-sort": "node ./scripts/verify-launcher-custom-sort.mjs",
    "test:launcher-drag": "node ./scripts/verify-launcher-drag.mjs",
    "test:launcher-fast-scroll": "node ./scripts/verify-launcher-fast-scroll.mjs",
    "test:launcher-cover-api-concurrency": "node ./scripts/probe-launcher-cover-api-concurrency.mjs --discover",
    "test:launcher-performance": "node ./scripts/verify-launcher-performance.mjs",
    "test:performance:pages": "node ./scripts/verify-page-performance.mjs",
    "test:performance:compiler-cleanup": "node ./scripts/verify-compiler-cleanup-performance.mjs",
    "test:performance": "vp run test:launcher-fast-scroll && vp run test:launcher-performance && vp run test:launcher-drag && vp run test:performance:compiler-cleanup && vp run test:performance:pages",
    "preview": "vp preview --configLoader runner",
    "tauri": "node ./scripts/run-tauri-cli.cjs"
  },
  "optionalDependencies": {
    "@rolldown/binding-linux-x64-gnu": "1.1.5",
    "@rolldown/binding-win32-x64-msvc": "1.1.5"
  },
  "devDependencies": {
    "@air/react-drag-to-select": "^5.0.11",
    "@babel/core": "^8.0.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@floating-ui/react": "^0.27.20",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@rolldown/plugin-babel": "0.2.3",
    "@tailwindcss/postcss": "^4.3.2",
    "@tanstack/react-virtual": "^3.14.5",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/cli": "^2.11.4",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@xyflow/react": "^12.11.2",
    "autoprefixer": "^10.5.2",
    "babel-plugin-react-compiler": "1.0.0",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^29.1.1",
    "lucide-react": "^1.24.0",
    "playwright": "^1.61.1",
    "postcss": "^8.5.16",
    "react": "^19.2.7",
    "react-devtools": "^7.0.1",
    "react-dom": "^19.2.7",
    "react-resizable-panels": "^4.12.1",
    "rolldown": "1.1.5",
    "tailwind-lint": "0.12.0",
    "tailwindcss": "^4.3.2",
    "typescript": "~7.0.2",
    "vite-plus": "catalog:",
    "vitest": "4.1.10",
    "zustand": "^5.0.14"
  },
  "main": "electron-dist/main.cjs",
  "build": {
    "appId": "io.github.Arborsm.ModForgeStudio",
    "productName": "ModForge Studio",
    "icon": "src-tauri/icons/icon.png",
    "beforeBuild": "./scripts/electron-builder-before-build.cjs",
    "files": [
      "dist/**",
      "electron-dist/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "src-tauri/target/release/modforge_sidecar",
        "to": "bin/modforge_sidecar"
      },
      {
        "from": "src-tauri/target/release/gmcm-probe",
        "to": "bin"
      },
      {
        "from": "src-tauri/icons/icon.png",
        "to": "icon.png"
      }
    ],
    "linux": {
      "executableName": "modforge-studio",
      "syncDesktopName": true,
      "artifactName": "modforge-studio-${version}-${arch}.${ext}",
      "maintainer": "ModForge Studio <dev@modforge.studio>",
      "synopsis": "Stardew Valley mod workbench",
      "description": "Desktop workbench for Stardew Valley mod creation and management.",
      "target": [
        "deb",
        "rpm",
        "AppImage"
      ],
      "category": "Development"
    },
    "deb": {
      "packageName": "modforge-studio"
    },
    "rpm": {
      "packageName": "modforge-studio"
    }
  },
  "dependencies": {
    "@bbob/plugin-helper": "^4.3.1",
    "@bbob/preset": "^4.3.1",
    "@bbob/react": "^4.3.1",
    "json5": "^2.2.3",
    "jszip": "^3.10.1"
  }
}
