    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "@xyflow/react": "^12.10.2",
    "autoprefixer": "^10.4.27",
    "lucide-react": "^1.8.0",
    "postcss": "^8.5.9",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-resizable-panels": "^4.10.0",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
